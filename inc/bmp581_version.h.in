/**
 * @file bmp581_version.h
 * @brief BMP581 driver version, generated by CMake from bmp581_version.h.in.
 * @copyright Copyright (c) 2026 The driver-bmp581 authors. SPDX-License-Identifier: MIT
 *
 * Do not edit the generated file: the version is set once, in cmake/bmp581_build_settings.cmake, and
 * configure_file() writes it here.
 */
#ifndef BMP581_VERSION_H
#define BMP581_VERSION_H

/** Major version: incompatible API changes. */
#define BMP581_VERSION_MAJOR @BMP581_VERSION_MAJOR@
/** Minor version: features added compatibly. */
#define BMP581_VERSION_MINOR @BMP581_VERSION_MINOR@
/** Patch version: fixes. */
#define BMP581_VERSION_PATCH @BMP581_VERSION_PATCH@
/** Full version string, for example "0.1.0". */
#define BMP581_VERSION_STRING "@BMP581_VERSION@"

#endif // BMP581_VERSION_H
